# Copy to .env.local for local dev; set the same names in Vercel > Project > Settings > Environment Variables.

# Website login
APP_PASSWORD=choose-a-long-password
# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Which VM to control
GCP_PROJECT_ID=my-project-id
GCE_ZONE=us-central1-a
GCE_INSTANCE=rdp-desktop
# Windows login shown on the dashboard (behind the site password). RDP_USERNAME also pre-fills the .rdp file.
RDP_USERNAME=ngcoding
# Optional. Mark it "Sensitive" in Vercel.
RDP_PASSWORD=

# --- Auth option A (simplest): service-account key, base64 of the JSON file ---
GCP_SA_KEY_B64=

# --- Auth option B (no stored key): Vercel OIDC -> Workload Identity Federation ---
# Setting GCP_WORKLOAD_IDENTITY_POOL_ID switches the app to this mode.
# GCP_PROJECT_NUMBER=
# GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
# GCP_SERVICE_ACCOUNT_EMAIL=rdp-website@my-project-id.iam.gserviceaccount.com
